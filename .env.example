# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=/data/app.db
# Comma-separated allowlist (unset = reflect any origin, credentials allowed)
CORS_ORIGIN=http://localhost:5173

# Web (dev proxy target)
API_URL=http://localhost:3000

# Cloudflare tunnel (T33 — remote access without port forwarding)
# TUNNEL_TOKEN=<token from Cloudflare Zero Trust → Networks → Tunnels>
# CORS_ORIGIN=https://mult.<your-domain>  (public origin served by the tunnel)

# TODO: add project-specific env vars here (one comment block per feature).
